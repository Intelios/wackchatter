# Auto detect text files and perform LF normalization
* text=auto

# Source is always text, even when a file legitimately contains a control character in a
# string or regex literal. Auto-detection sees the NUL and marks the whole file binary,
# which silently turns off diffs for it — worst of all in the path sanitiser, where an
# unreviewable change is the last thing anyone wants.
*.ts text diff
*.tsx text diff
*.onnx binary

# Launchers must be checked out with the line endings their interpreter expects, whatever
# the platform or the user's core.autocrlf. A shell script that arrives with CRLF fails on
# the shebang line with "bad interpreter", which reads like the script is broken rather
# than merely mispunctuated.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
